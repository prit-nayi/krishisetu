# KrishiLink AI — environment template
# Copy to .env and fill in real values. Never commit .env to git.

DJANGO_SETTINGS_MODULE=krishilink.settings.development
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave blank to use SQLite for local dev)
DATABASE_URL=

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0

# IBM watsonx.ai
IBM_WATSONX_URL=
IBM_WATSONX_API_KEY=
IBM_WATSONX_PROJECT_ID=
IBM_GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Market Data (Phase 3) — data.gov.in AGMARKNET
# Get your API key at https://data.gov.in/user/register
# Used only server-side by the sync_market_prices management command.
# Never expose this key to the frontend.
DATA_GOV_API_KEY=579b464db66ec23bdd000001bf718c41a15b497b66eb54dc36a0b69a

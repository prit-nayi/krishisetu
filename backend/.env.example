# ──────────────────────────────────────────────────────────────────────────────
# KrishiLink AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=krishilink.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev without Docker):
# DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (Docker or hosted):
DATABASE_URL=postgres://krishilink:krishilink@localhost:5432/krishilink_dev

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Redis / Celery ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0

# ── IBM Granite (watsonx.ai) ──────────────────────────────────────────────────
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_API_KEY=your-ibm-cloud-api-key
IBM_WATSONX_PROJECT_ID=your-watsonx-project-id
IBM_GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2
